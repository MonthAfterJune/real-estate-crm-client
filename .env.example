# Browser authentication uses same-origin cookies. Leave the base URL empty.
# Production: serve the React app and reverse-proxy /api on the same HTTPS host.
VITE_API_BASE_URL=

# Vite forwards /api to the local ASP.NET HTTPS development profile.
# For IIS Express, use https://localhost:44346 instead.
API_PROXY_TARGET=https://localhost:7116
